@page "/"
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject ILogger<Home> Logger
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using System.Text.Json.Serialization

@*
  Frontend → API: publika HTTPS-URL:en + Bearer från Easy Auth (/.auth/me).
  API → Storage: via backend-subnet.
*@

@if (!authChecked)
{
    <p>Kollar inloggning...</p>
}
else if (!loggedIn)
{
    <p>Du måste logga in för att använda MinGram.</p>
    <p><a href="/.auth/login/aad?post_login_redirect_uri=/">Logga in med Microsoft</a></p>
}
else
{
    <p class="inloggad">Inloggad som @currentUser</p>

    <h2>Bilder</h2>

    @if (laddar)
    {
        <p>Hämtar bilder...</p>
    }
    else if (!string.IsNullOrEmpty(felmeddelande) && bilder.Count == 0)
    {
        <p class="fel">@felmeddelande</p>
    }
    else if (bilder.Count == 0)
    {
        <p>Inga bilder ännu. Ladda upp den första!</p>
    }
    else
    {
        <div class="bildgalleri">
            @foreach (var bild in bilder)
            {
                <div class="bildkort">
                    <img src="@bild.Url" alt="@bild.Caption" />
                    <div class="bildinfo">
                        <p class="caption">@bild.Caption</p>
                        <p class="taggar">
                            @string.Join(" · ", bild.Taggar.Select(t => $"#{t}"))
                        </p>
                        <button class="raderaknapp" @onclick="() => RaderaBild(bild.Id)">
                            Ta bort
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <hr />

    <h2>Ladda upp bild</h2>

    <div class="uppladdningsformular">
        <div class="falt">
            <label>Bild</label>
            <InputFile OnChange="FilVald" accept="image/*" />
        </div>
        <div class="falt">
            <label>Caption</label>
            <input type="text" @bind="caption" placeholder="Beskriv bilden..." />
        </div>
        <div class="falt">
            <label>Taggar (kommaseparerade)</label>
            <input type="text" @bind="taggar" placeholder="semester, strand, sol" />
        </div>
        <button @onclick="LaddaUpp" disabled="@(valdFil == null || laddarUpp)">
            @(laddarUpp ? "Laddar upp..." : "Ladda upp")
        </button>
        @if (!string.IsNullOrEmpty(felmeddelande))
        {
            <p class="fel">@felmeddelande</p>
        }
    </div>
}

@code {
    private List<Bild> bilder = new();
    private bool laddar = false;
    private bool laddarUpp = false;
    private string caption = "";
    private string taggar = "";
    private IBrowserFile? valdFil;
    private string felmeddelande = "";
    private string? accessToken;
    private bool loggedIn;
    private string currentUser = "";
    private bool authChecked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await KontrolleraInloggning();
        authChecked = true;

        if (loggedIn)
            await HamtaBilder();

        StateHasChanged();
    }

    private HttpClient SkapaKlient()
    {
        var client = HttpClientFactory.CreateClient("MinGramApi");
        client.DefaultRequestHeaders.Remove("Authorization");
        client.DefaultRequestHeaders.Remove("X-User-Email");

        // Bearer om Easy Auth gav API-token; annars e-postheader (workaround utan Emma).
        if (!string.IsNullOrWhiteSpace(accessToken))
        {
            client.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", accessToken);
        }

        if (!string.IsNullOrWhiteSpace(currentUser) && currentUser.Contains('@'))
            client.DefaultRequestHeaders.TryAddWithoutValidation("X-User-Email", currentUser);

        return client;
    }

    private async Task KontrolleraInloggning()
    {
        try
        {
            var users = await JS.InvokeAsync<List<AuthUser>>("fetchAuthUser");
            var user = users?.FirstOrDefault();

            if (string.IsNullOrWhiteSpace(user?.UserId))
            {
                loggedIn = false;
                currentUser = "";
                accessToken = null;
                return;
            }

            loggedIn = true;
            currentUser = user.UserDetails ?? user.UserId;
            accessToken = user.AccessToken;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Kunde inte kontrollera inloggningen.");
            loggedIn = false;
            currentUser = "";
            accessToken = null;
        }
    }

    private async Task HamtaBilder()
    {
        laddar = true;
        felmeddelande = "";

        try
        {
            var client = SkapaKlient();
            var response = await client.GetAsync("/bilder");

            if (!response.IsSuccessStatusCode)
            {
                felmeddelande = $"Kunde inte hämta bilder ({(int)response.StatusCode}).";
                bilder = new();
                return;
            }

            var svar = await response.Content.ReadFromJsonAsync<List<Bild>>();
            bilder = svar ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Kunde inte hämta bilder");
            felmeddelande = "Kunde inte hämta bilder från API:t.";
            bilder = new();
        }
        finally
        {
            laddar = false;
        }
    }

    private void FilVald(InputFileChangeEventArgs e)
    {
        valdFil = e.File;
        felmeddelande = "";
    }

    private async Task LaddaUpp()
    {
        if (valdFil == null) return;

        laddarUpp = true;
        felmeddelande = "";

        try
        {
            var client = SkapaKlient();

            using var content = new MultipartFormDataContent();
            var stream = valdFil.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType =
                new MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(valdFil.ContentType)
                        ? "image/jpeg"
                        : valdFil.ContentType);

            content.Add(fileContent, "fil", valdFil.Name);
            content.Add(new StringContent(caption), "caption");
            content.Add(new StringContent(valdFil.Name), "namn");
            content.Add(new StringContent(taggar), "taggar");

            var response = await client.PostAsync("/bilder/uppladdning", content);

            if (!response.IsSuccessStatusCode)
            {
                felmeddelande = $"Kunde inte ladda upp bilden ({(int)response.StatusCode}).";
                return;
            }

            valdFil = null;
            caption = "";
            taggar = "";
            await HamtaBilder();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fel vid uppladdning");
            felmeddelande = "Ett fel uppstod vid uppladdningen.";
        }
        finally
        {
            laddarUpp = false;
        }
    }

    private async Task RaderaBild(int id)
    {
        felmeddelande = "";

        try
        {
            var client = SkapaKlient();
            var response = await client.DeleteAsync($"/bilder/{id}");

            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                felmeddelande = "403 Forbidden — du saknar behörighet att radera.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                felmeddelande = $"Kunde inte radera bilden ({(int)response.StatusCode}).";
                return;
            }

            await HamtaBilder();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fel vid radering");
            felmeddelande = "Kunde inte radera bilden.";
        }
    }

    private record Bild(
        int Id,
        string Namn,
        string Caption,
        List<string> Taggar,
        string Url
    );

    private sealed class AuthUser
    {
        [JsonPropertyName("user_id")]
        public string? UserId { get; set; }

        [JsonPropertyName("user_claims")]
        public List<object>? UserClaims { get; set; }

        [JsonPropertyName("access_token")]
        public string? AccessToken { get; set; }

        [JsonPropertyName("provider_name")]
        public string? ProviderName { get; set; }

        [JsonPropertyName("user_details")]
        public string? UserDetails { get; set; }
    }
}

<style>
    .inloggad { color: #555; font-size: 0.9rem; margin-bottom: 1rem; }
    h2 { margin: 1.5rem 0 1rem; font-size: 1.2rem; color: #555; text-transform: uppercase; letter-spacing: 1px; }
    hr { border: none; border-top: 1px solid #eee; margin: 2rem 0; }

    .bildgalleri {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1rem;
    }

    .bildkort {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,0.1);
    }

    .bildkort img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
    }

    .bildinfo   { padding: 0.75rem; }
    .caption    { font-weight: 600; margin-bottom: 0.25rem; }
    .taggar     { font-size: 0.8rem; color: #3897f0; margin-bottom: 0.5rem; }

    .raderaknapp {
        background: none;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        padding: 0.3rem 0.75rem;
        cursor: pointer;
        color: #e53935;
        font-size: 0.8rem;
    }

    .raderaknapp:hover { background: #ffeaea; }

    .uppladdningsformular { max-width: 500px; }
    .falt         { margin-bottom: 1rem; }
    .falt label   { display: block; font-weight: 600; margin-bottom: 0.35rem; font-size: 0.9rem; }
    .falt input   { width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #dbdbdb; border-radius: 4px; font-size: 1rem; }

    .uppladdningsformular button {
        background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
        color: white;
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 4px;
        cursor: pointer;
        font-size: 1rem;
    }

    button[disabled] { opacity: 0.5; cursor: not-allowed; }
    .fel { color: #e53935; margin-top: 0.5rem; font-size: 0.9rem; }
</style>
